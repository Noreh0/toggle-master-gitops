+# Provisionamento do Grafana Alerting (regra, contact point e política), montado em
+# /etc/grafana/provisioning/alerting pelo values do kube-prometheus-stack (extraConfigmapMounts).
+#
+# Fluxo da demo: auth-service com mais de 5% de respostas 5xx
+#   -> regra "Firing" -> contact point "oncall" -> PagerDuty (incidente) + Discord (aviso)
+#                                               + GitHub Actions (kubectl rollout restart)
+#
+# Os valores sensíveis vêm de variáveis de ambiente (Secret grafana-alerting-secrets, criado pelo
+# scripts/bootstrap.sh). O provisionamento do Grafana interpola ${VARIAVEL} nos campos dos
+# contact points; nada disso vai para o Git.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: grafana-alerting-provisioning
+  namespace: monitoring
+data:
+  contactpoints.yaml: |
+    apiVersion: 1
+    contactPoints:
+      - orgId: 1
+        name: oncall
+        receivers:
+          # 1) Incidente no PagerDuty (Events API v2)
+          - uid: oncall-pagerduty
+            type: pagerduty
+            settings:
+              integrationKey: ${PAGERDUTY_INTEGRATION_KEY}
+              severity: critical
+              class: http-5xx
+              component: auth-service
+              group: toggle-master
+
+          # 2) Notificação no canal do Discord (ChatOps)
+          - uid: oncall-discord
+            type: discord
+            settings:
+              url: ${DISCORD_WEBHOOK_URL}
+
+          # 3) Auto-reparo: dispara o workflow self-heal.yaml (kubectl rollout restart) via API do GitHub.
+          #    O GitHub exige "ref" no corpo, por isso o payload customizado. Não dispara ao resolver.
+          - uid: oncall-selfheal
+            type: webhook
+            disableResolveMessage: true
+            settings:
+              url: https://api.github.com/repos/Noreh0/toggle-master-k8s/actions/workflows/self-heal.yaml/dispatches
+              httpMethod: POST
+              authorization_scheme: Bearer
+              authorization_credentials: ${GITHUB_DISPATCH_TOKEN}
+              headers:
+                Accept: application/vnd.github+json
+                X-GitHub-Api-Version: "2022-11-28"
+              payload:
+                template: '{"ref":"main","inputs":{"deployment":"auth-service","reason":"alerta do Grafana: auth-service 5xx acima de 5%"}}'
+
+  policies.yaml: |
+    apiVersion: 1
+    policies:
+      - orgId: 1
+        receiver: oncall
+        group_by: [alertname, service]
+        group_wait: 10s
+        group_interval: 1m
+        repeat_interval: 1h
+
+  rules.yaml: |
+    apiVersion: 1
+    groups:
+      - orgId: 1
+        name: toggle-master-slo
+        folder: ToggleMaster
+        interval: 30s
+        rules:
+          - uid: auth-5xx-ratio
+            title: auth-service com mais de 5% de respostas 5xx
+            condition: C
+            for: 30s
+            noDataState: OK
+            execErrState: Error
+            labels:
+              severity: critical
+              service: auth-service
+            annotations:
+              summary: "auth-service está com {{ printf \"%.1f\" $values.B.Value }}% de respostas 5xx"
+              description: "Mais de 5% das requisições ao auth-service falharam com 5xx na última janela de 1 minuto. O auto-reparo reinicia o deployment (kubectl rollout restart)."
+            data:
+              # A: percentual de spans SERVER com erro no auth-service (spanmetrics do OTel Collector)
+              - refId: A
+                relativeTimeRange:
+                  from: 300
+                  to: 0
+                datasourceUid: prometheus
+                model:
+                  refId: A
+                  datasource:
+                    type: prometheus
+                    uid: prometheus
+                  expr: '100 * (sum(rate(traces_span_metrics_calls_total{service_name="auth-service",span_kind="SPAN_KIND_SERVER",status_code="STATUS_CODE_ERROR"}[1m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name="auth-service",span_kind="SPAN_KIND_SERVER"}[1m]))'
+                  instant: true
+                  intervalMs: 1000
+                  maxDataPoints: 43200
+              # B: último valor
+              - refId: B
+                datasourceUid: __expr__
+                model:
+                  refId: B
+                  type: reduce
+                  expression: A
+                  reducer: last
+                  datasource:
+                    type: __expr__
+                    uid: __expr__
+              # C: dispara quando B > 5
+              - refId: C
+                datasourceUid: __expr__
+                model:
+                  refId: C
+                  type: threshold
+                  expression: B
+                  conditions:
+                    - evaluator:
+                        type: gt
+                        params: [5]
+                  datasource:
+                    type: __expr__
+                    uid: __expr__
