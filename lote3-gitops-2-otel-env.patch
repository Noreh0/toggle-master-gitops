 apps/auth/deployment.yaml       | 14 ++++++++++++++
 apps/evaluation/deployment.yaml | 11 +++++++++++
 apps/flag/deployment.yaml       | 11 +++++++++++
 apps/targeting/deployment.yaml  | 11 +++++++++++
 5 files changed, 58 insertions(+)

diff --git a/apps/analytics/deployment.yaml b/apps/analytics/deployment.yaml
index 98acca6..f408440 100644
--- a/apps/analytics/deployment.yaml
+++ b/apps/analytics/deployment.yaml
@@ -25,6 +25,17 @@ spec:
             cpu: "200m"
             memory: "256Mi"
         env:
+        # --- OpenTelemetry: tudo vai para o OTel Collector (namespace monitoring) ---
+        - name: OTEL_SERVICE_NAME
+          value: "analytics-service"
+        - name: OTEL_EXPORTER_OTLP_ENDPOINT
+          value: "http://otel-collector.monitoring.svc.cluster.local:4318"
+        - name: OTEL_EXPORTER_OTLP_PROTOCOL
+          value: "http/protobuf"
+        - name: OTEL_RESOURCE_ATTRIBUTES
+          value: "service.namespace=toggle-master,deployment.environment=demo"
+        - name: OTEL_SEMCONV_STABILITY_OPT_IN
+          value: "http"
         - name: AWS_REGION
           value: "us-east-1"
         - name: AWS_SQS_URL
diff --git a/apps/auth/deployment.yaml b/apps/auth/deployment.yaml
index 20a0ba7..8e7c91d 100644
--- a/apps/auth/deployment.yaml
+++ b/apps/auth/deployment.yaml
@@ -19,6 +19,20 @@ spec:
         ports:
         - containerPort: 8001
         env:
+        # --- OpenTelemetry: tudo vai para o OTel Collector (namespace monitoring) ---
+        - name: OTEL_SERVICE_NAME
+          value: "auth-service"
+        - name: OTEL_EXPORTER_OTLP_ENDPOINT
+          value: "http://otel-collector.monitoring.svc.cluster.local:4318"
+        - name: OTEL_EXPORTER_OTLP_PROTOCOL
+          value: "http/protobuf"
+        - name: OTEL_RESOURCE_ATTRIBUTES
+          value: "service.namespace=toggle-master,deployment.environment=demo"
+        - name: OTEL_SEMCONV_STABILITY_OPT_IN
+          value: "http"
+        # Habilita POST /admin/chaos (protegido pela MASTER_KEY) para a demo de auto-recuperação.
+        - name: ENABLE_CHAOS
+          value: "true"
         - name: PORT
           value: "8001"
         - name: DATABASE_URL
