+# Loki em modo Monolithic (um único pod), armazenamento em filesystem efêmero.
+# Chart: grafana-community/loki (o chart grafana/loki foi descontinuado; ver versão na Application).
+deploymentMode: Monolithic
+
+loki:
+  auth_enabled: false
+  commonConfig:
+    replication_factor: 1 # com 1 réplica, qualquer outro valor faz as escritas falharem
+  storage:
+    type: filesystem
+  schemaConfig:
+    configs:
+      - from: "2024-04-01"
+        store: tsdb
+        object_store: filesystem
+        schema: v13
+        index:
+          prefix: loki_index_
+          period: 24h
+  limits_config:
+    # Necessário para a ingestão nativa por OTLP (o OTel Collector envia para /otlp).
+    allow_structured_metadata: true
+    volume_enabled: true
+
+singleBinary:
+  replicas: 1
+  persistence:
+    enabled: false # emptyDir: o cluster não tem EBS CSI e os logs da demo são descartáveis
+  resources:
+    requests: { cpu: 100m, memory: 256Mi }
+    limits: { memory: 768Mi }
+
+# Componentes que não existem no modo Monolithic ou pesam sem necessidade nesta demo.
+gateway:
+  enabled: false
+chunksCache:
+  enabled: false
+resultsCache:
+  enabled: false
+lokiCanary:
+  enabled: false
+test:
+  enabled: false
+minio:
+  enabled: false
+
+backend:
+  replicas: 0
+read:
+  replicas: 0
+write:
+  replicas: 0
+ingester:
+  replicas: 0
+querier:
+  replicas: 0
+queryFrontend:
+  replicas: 0
+queryScheduler:
+  replicas: 0
+distributor:
+  replicas: 0
+compactor:
+  replicas: 0
+indexGateway:
+  replicas: 0
+bloomPlanner:
+  replicas: 0
+bloomBuilder:
+  replicas: 0
+bloomGateway:
+  replicas: 0
diff --git a/monitoring/values/otel-collector-gateway.yaml b/monitoring/values/otel-collector-gateway.yaml
new file mode 100644
index 0000000..3198c65
--- /dev/null
+++ b/monitoring/values/otel-collector-gateway.yaml
@@ -0,0 +1,94 @@
+# OpenTelemetry Collector "gateway": o hub de telemetria.
+#
+#   apps (OTLP/HTTP :4318) --> este Collector --+--> Prometheus (remote write)  métricas
+#                                               +--> New Relic (OTLP)           traces / APM
+#                                               +--> Loki (OTLP)                logs recebidos por OTLP
+#
+# Os logs dos pods (stdout) são coletados por outro Collector, o de logs (DaemonSet),
+# que também entrega no Loki. Serviço para os apps: otel-collector.monitoring.svc:4318
+mode: deployment
+replicaCount: 1
+fullnameOverride: otel-collector
+
+# A imagem "contrib" tem o prometheusremotewrite, o spanmetrics e o k8sattributes.
+image:
+  repository: otel/opentelemetry-collector-contrib
+command:
+  name: otelcol-contrib
+
+presets:
+  # Acrescenta o k8s.pod.name / k8s.namespace.name / k8s.deployment.name nos dados
+  # (e cria o RBAC necessário).
+  kubernetesAttributes:
+    enabled: true
+
+extraEnvs:
+  - name: NEW_RELIC_LICENSE_KEY
+    valueFrom:
+      secretKeyRef:
+        name: newrelic-license # Secret criado pelo scripts/bootstrap.sh
+        key: NEW_RELIC_LICENSE_KEY
+
+# Só OTLP é usado; as portas jaeger/zipkin do chart ficam fechadas.
+ports:
+  jaeger-compact:
+    enabled: false
+  jaeger-thrift:
+    enabled: false
+  jaeger-grpc:
+    enabled: false
+  zipkin:
+    enabled: false
+
+resources:
+  requests: { cpu: 100m, memory: 256Mi }
+  limits: { memory: 512Mi }
+
+config:
+  receivers:
+    otlp:
+      protocols:
+        http:
+          endpoint: 0.0.0.0:4318
+        grpc:
+          endpoint: 0.0.0.0:4317
+
+  connectors:
+    # Gera métricas RED a partir dos spans (traces_span_metrics_calls_total e
+    # traces_span_metrics_duration_milliseconds_*). É a base do painel de taxa de requisições
+    # e do alerta de 5xx: um span SERVER com status ERROR é uma resposta 5xx, e isso vale
+    # igual para os 5 serviços, independentemente da versão da semconv de cada SDK.
+    spanmetrics:
+      metrics_flush_interval: 15s
+      histogram:
+        explicit:
+          buckets: [5ms, 10ms, 25ms, 50ms, 100ms, 250ms, 500ms, 1s, 2500ms, 5s]
+
+  exporters:
+    prometheusremotewrite:
+      endpoint: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090/api/v1/write
+      resource_to_telemetry_conversion:
+        enabled: true # service.name vira o label service_name no Prometheus
+      target_info:
+        enabled: false
+    otlphttp/newrelic:
+      endpoint: https://otlp.nr-data.net # conta US
+      headers:
+        api-key: ${env:NEW_RELIC_LICENSE_KEY}
+    otlphttp/loki:
+      endpoint: http://loki.monitoring.svc.cluster.local:3100/otlp
+
+  service:
+    pipelines:
+      traces:
+        receivers: [otlp]
+        processors: [memory_limiter, batch]
+        exporters: [spanmetrics, otlphttp/newrelic]
+      metrics:
+        receivers: [otlp, spanmetrics]
+        processors: [memory_limiter, batch]
+        exporters: [prometheusremotewrite]
+      logs:
+        receivers: [otlp]
+        processors: [memory_limiter, batch]
+        exporters: [otlphttp/loki]
diff --git a/monitoring/values/otel-collector-logs.yaml b/monitoring/values/otel-collector-logs.yaml
new file mode 100644
index 0000000..816bf2f
--- /dev/null
+++ b/monitoring/values/otel-collector-logs.yaml
@@ -0,0 +1,57 @@
+# OpenTelemetry Collector "agente de logs" (DaemonSet): lê o stdout dos pods do namespace
+# toggle-app em cada node e entrega no Loki por OTLP.
+mode: daemonset
+fullnameOverride: otel-collector-logs
+
+image:
+  repository: otel/opentelemetry-collector-contrib
+command:
+  name: otelcol-contrib
+
+presets:
+  logsCollection:
+    enabled: true
+    includeCollectorLogs: false
+  kubernetesAttributes:
+    enabled: true
+
+# Este agente só lê arquivos: nenhuma porta de recepção.
+ports:
+  otlp:
+    enabled: false
+  otlp-http:
+    enabled: false
+  jaeger-compact:
+    enabled: false
+  jaeger-thrift:
+    enabled: false
+  jaeger-grpc:
+    enabled: false
+  zipkin:
+    enabled: false
+
+resources:
+  requests: { cpu: 50m, memory: 96Mi }
+  limits: { memory: 256Mi }
+
+config:
+  receivers:
+    filelog:
+      # Só os pods da aplicação. Os logs da própria stack de observabilidade não interessam à demo.
+      include:
+        - /var/log/pods/toggle-app_*/*/*.log
+      start_at: end
+
+  exporters:
+    otlphttp/loki:
+      endpoint: http://loki.monitoring.svc.cluster.local:3100/otlp
+
+  service:
+    pipelines:
+      # Este agente não recebe traces nem métricas.
+      traces: null
+      metrics: null
+      logs:
+        receivers: [filelog]
+        processors: [memory_limiter, batch]
+        exporters: [otlphttp/loki]
